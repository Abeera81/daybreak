# Copy this file to ~/.hermes/.env and fill in real values.
# Never commit the real .env — it holds secrets.

# --- Discord delivery (required) ---
# Create a bot at https://discord.com/developers/applications -> Bot -> token.
# Enable the "Message Content Intent". Invite the bot to a server you own.
# Your numeric Discord user id: enable Developer Mode, right-click your name -> Copy User ID.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_ALLOWED_USERS=000000000000000000

# --- GitHub notifications (optional) ---
# A fine-grained PAT with read-only "Notifications" access.
# Leave blank to skip the GitHub step in the brief.
GITHUB_TOKEN=

# --- Model (set via `hermes model`, shown here for reference) ---
# Use any FREE model with >= 64K context (e.g. Google AI Studio gemini-2.5-flash,
# or a ":free" OpenRouter variant). The API key is stored by `hermes model`, not here.
