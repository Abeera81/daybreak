# Copy this file to ~/.hermes/.env and fill in real values.
# Never commit the real .env — it holds secrets.

# --- Telegram delivery (required) ---
# Get a bot token from @BotFather, then your numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyz
TELEGRAM_ALLOWED_USERS=000000000

# --- GitHub notifications (optional) ---
# A fine-grained PAT with read-only "Notifications" access.
# Leave blank to skip the GitHub step in the brief.
GITHUB_TOKEN=

# --- Model (set via `hermes model`, shown here for reference) ---
# Use a FREE OpenRouter model with >= 64K context, e.g. a ":free" variant.
# OPENROUTER_API_KEY is stored by `hermes model`, not here.
